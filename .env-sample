# AWS CDK Environment Configuration
# Copy this file to .env and fill in your values, then source it:
#   cp .env-sample .env
#   # Edit .env with your values
#   source .env

# =============================================================================
# Required: AWS Account Configuration
# =============================================================================

# AWS Account ID for deployment
export CDK_DEPLOY_ACCOUNT="123456789012"

# AWS Region for deployment (e.g., us-east-1, eu-west-1)
export CDK_DEPLOY_REGION="us-east-1"

# =============================================================================
# Optional: Stack Configuration
# =============================================================================

# Stack name prefix (default: dev)
export CDK_PREFIX="dev"

# Application type to deploy
# Options: eth1, wireguard, socat, rds_integration, https_web_server, 
#          dotnet_sqs_integration, enclave_performance
export CDK_APPLICATION_TYPE="eth1"

# =============================================================================
# Optional: Enclave Performance Stack Only
# =============================================================================

# Target CPU architecture for enclave_performance stack
# Options: x86 (Intel m6i.xlarge), arm64 (Graviton m7g.xlarge)
# Default: x86
export CDK_TARGET_ARCHITECTURE="x86"
